# =============================================================================
# Smart Student Commute Companion - Backend Environment Configuration
# =============================================================================

# Server Port (integer between 1 and 65535, default: 5000)
PORT=5000

# Server Host bind address (default: 0.0.0.0)
HOST=0.0.0.0

# Application Environment ('development' | 'production' | 'test', default: development)
NODE_ENV=development

# Frontend Client URL for CORS and Socket.IO origin authorization (default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key for AI-powered commute explanations (Optional)
# If omitted or empty, the backend automatically uses a deterministic grounded explanation engine.
GEMINI_API_KEY=

# Enforce Gemini API Key requirement (boolean: 'true' | 'false', default: false)
# When set to true, application startup will fail if GEMINI_API_KEY is not provided.
REQUIRE_GEMINI_KEY=false

# SQLite Database File Path (Optional)
# Defaults to ./db/commute.db relative to the backend root directory.
# DATABASE_PATH=./db/commute.db

# Enable the admin-only POST /api/demo/reset endpoint (default: true outside production,
# false in production). It wipes community reports, ride groups and feedback.
# ALLOW_DEMO_RESET=false

# Secret used to sign session tokens (REQUIRED in production, min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset outside production a random per-process secret is used (sessions end on restart).
JWT_SECRET=

# Google OAuth client id for "Continue with Google" (optional). Must equal the
# frontend's VITE_GOOGLE_CLIENT_ID; ID tokens are verified server-side against it.
GOOGLE_CLIENT_ID=

# --- Deployment / transport security -----------------------------------------
# Number of reverse proxies in front of the app (e.g. 1), 'true', or a subnet
# list. Required for correct client IPs (rate limiting) and HTTPS detection
# behind a TLS-terminating proxy. Leave 'false' when exposed directly.
TRUST_PROXY=false

# Encrypts sensitive profile fields at rest with AES-256-GCM (e.g. a student's home
# area). REQUIRED in production. Exactly 32 random bytes as 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECRET: keep it out of git and out of the database. Losing it makes the encrypted
# values unrecoverable; changing it requires re-encrypting existing rows.
FIELD_ENCRYPTION_KEY=

# Browser session cookie (HttpOnly, Secure over HTTPS) SameSite policy: lax | strict | none.
# 'lax' suits a same-site deployment. Use 'none' (requires HTTPS) only when the
# frontend and API live on different sites; CORS origins stay an explicit allowlist.
SESSION_COOKIE_SAMESITE=lax

# Redirect plain-HTTP requests to HTTPS (308 for GET/HEAD, 426 otherwise).
# Requires TRUST_PROXY; /health stays reachable over HTTP for load balancers.
FORCE_HTTPS=false

# Send Strict-Transport-Security over HTTPS. Opt-in: browsers cache it, so only
# enable once the domain is committed to HTTPS.
ENABLE_HSTS=false
HSTS_MAX_AGE_SECONDS=15552000

# --- Supabase (optional cloud database / auth sync) ---------------------------
# Without these the app runs entirely on local SQLite.
SUPABASE_URL=
# Public anon key: safe for browsers, restricted by Row Level Security.
SUPABASE_ANON_KEY=
# SECRET: bypasses Row Level Security. Backend process only. Never prefix with
# VITE_, never commit it, never paste it into client code or chat. Rotate it
# immediately in the Supabase dashboard if it is ever exposed.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# SECURITY NOTES FOR OPERATORS
# - Copy this file to .env (git-ignored). Never commit real values.
# - Every value in this file is a placeholder. JWT_SECRET, SUPABASE_SERVICE_ROLE_KEY,
#   GROQ_API_KEY and GEMINI_API_KEY are server-side secrets: they must never
#   appear in frontend code, VITE_* variables, logs, or screenshots.
# - If a secret is ever committed or leaked, rotate it at the provider first,
#   then remove it from git history; deleting the file is not enough.
# - Run `npm audit` in backend/ and frontend/ before every release.
# =============================================================================
